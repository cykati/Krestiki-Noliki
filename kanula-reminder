<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#2b5b8c">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Смена канюли</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💉</text></svg>">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
:root{
    --bg:#0d1117;
    --bg-2:#161b22;
    --bg-3:#21262d;
    --text:#e6edf3;
    --text-2:#8b949e;
    --accent:#3498db;
    --accent-2:#2b5b8c;
    --success:#2ecc71;
    --warning:#f39c12;
    --danger:#e74c3c;
    --border:#30363d;
    --shadow:0 4px 20px rgba(0,0,0,.4);
}
@media(prefers-color-scheme: light){
    :root{
        --bg:#f5f7fa;
        --bg-2:#ffffff;
        --bg-3:#eef1f5;
        --text:#1a1a1a;
        --text-2:#6b7280;
        --accent:#2563eb;
        --accent-2:#1e40af;
        --border:#e5e7eb;
        --shadow:0 4px 20px rgba(0,0,0,.08);
    }
}
body{
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
    background:var(--bg);
    color:var(--text);
    min-height:100vh;
    padding-bottom:80px;
    overflow-x:hidden;
    transition:background .3s,color .3s;
}

/* ===== HEADER ===== */
.header{
    position:sticky;top:0;z-index:100;
    background:var(--bg-2);
    border-bottom:1px solid var(--border);
    padding:16px 20px;
    display:flex;justify-content:space-between;align-items:center;
    backdrop-filter:blur(10px);
}
.header h1{
    font-size:18px;font-weight:700;
    display:flex;align-items:center;gap:8px;
}
.header h1 span.icon{font-size:22px;}
.header .btn-icon{
    width:40px;height:40px;
    border:none;background:var(--bg-3);
    color:var(--text);border-radius:50%;
    cursor:pointer;font-size:18px;
    display:flex;justify-content:center;align-items:center;
    transition:.2s;
}
.header .btn-icon:hover{background:var(--accent);color:#fff;}

/* ===== MAIN ===== */
.main{padding:20px;max-width:600px;margin:0 auto;}

/* ===== CARD ===== */
.card{
    background:var(--bg-2);
    border:1px solid var(--border);
    border-radius:16px;
    padding:20px;
    margin-bottom:16px;
    box-shadow:var(--shadow);
    transition:.3s;
}
.card-title{
    font-size:13px;
    color:var(--text-2);
    text-transform:uppercase;
    letter-spacing:1px;
    font-weight:600;
    margin-bottom:12px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}
.card-value{
    font-size:32px;
    font-weight:800;
    margin-bottom:6px;
    line-height:1.2;
}
.card-subtitle{
    font-size:14px;
    color:var(--text-2);
}

/* ===== ГЛАВНАЯ КАРТОЧКА СТАТУСА ===== */
.status-card{
    background:linear-gradient(135deg,var(--accent),var(--accent-2));
    border:none;
    color:#fff;
    text-align:center;
    position:relative;
    overflow:hidden;
}
.status-card::before{
    content:'';
    position:absolute;
    top:-50%;right:-50%;
    width:200%;height:200%;
    background:radial-gradient(circle,rgba(255,255,255,.1) 0%,transparent 70%);
    animation:rotate 20s linear infinite;
}
@keyframes rotate{
    from{transform:rotate(0deg);}
    to{transform:rotate(360deg);}
}
.status-card .status-emoji{
    font-size:56px;
    margin-bottom:12px;
    position:relative;
    z-index:1;
    animation:pulse 2s ease infinite;
}
@keyframes pulse{
    0%,100%{transform:scale(1);}
    50%{transform:scale(1.1);}
}
.status-card .status-title{
    font-size:22px;
    font-weight:800;
    margin-bottom:8px;
    position:relative;
    z-index:1;
}
.status-card .status-subtitle{
    font-size:14px;
    opacity:0.9;
    margin-bottom:16px;
    position:relative;
    z-index:1;
}
.status-card .status-time{
    font-size:36px;
    font-weight:900;
    font-family:'Courier New',monospace;
    margin-bottom:4px;
    position:relative;
    z-index:1;
}
.status-card .status-label{
    font-size:12px;
    opacity:0.85;
    text-transform:uppercase;
    letter-spacing:1.5px;
    position:relative;
    z-index:1;
}

/* ВАРИАНТЫ СТАТУСА */
.status-card.warning{
    background:linear-gradient(135deg,#f39c12,#e67e22);
}
.status-card.danger{
    background:linear-gradient(135deg,#e74c3c,#c0392b);
    animation:shake 1.5s ease infinite;
}
@keyframes shake{
    0%,100%{transform:translateX(0);}
    25%{transform:translateX(-3px);}
    75%{transform:translateX(3px);}
}
.status-card.ok{
    background:linear-gradient(135deg,#2ecc71,#27ae60);
}

/* ===== ПРОГРЕСС-БАР ===== */
.progress-bar{
    width:100%;
    height:10px;
    background:rgba(0,0,0,.2);
    border-radius:5px;
    overflow:hidden;
    margin:12px 0 8px 0;
    position:relative;
    z-index:1;
}
.progress-fill{
    height:100%;
    background:linear-gradient(90deg,#fff,#f0f0f0);
    border-radius:5px;
    transition:width 1s ease;
    box-shadow:0 0 10px rgba(255,255,255,.5);
}

/* ===== БОЛЬШАЯ КНОПКА ===== */
.big-btn{
    width:100%;
    padding:20px;
    font-size:18px;
    font-weight:800;
    border:none;
    border-radius:16px;
    background:var(--success);
    color:#fff;
    cursor:pointer;
    transition:.2s;
    display:flex;
    justify-content:center;
    align-items:center;
    gap:10px;
    box-shadow:0 6px 20px rgba(46,204,113,.4);
    margin-bottom:16px;
}
.big-btn:hover{transform:scale(1.02);box-shadow:0 8px 25px rgba(46,204,113,.5);}
.big-btn:active{transform:scale(0.98);}
.big-btn.btn-blue{background:var(--accent);box-shadow:0 6px 20px rgba(52,152,219,.4);}
.big-btn.btn-blue:hover{box-shadow:0 8px 25px rgba(52,152,219,.5);}
.big-btn .icon{font-size:24px;}

/* ===== НАСТРОЙКИ ===== */
.setting-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:14px 0;
    border-bottom:1px solid var(--border);
}
.setting-row:last-child{border-bottom:none;}
.setting-row .label{
    font-size:15px;
    font-weight:600;
}
.setting-row .desc{
    font-size:12px;
    color:var(--text-2);
    margin-top:2px;
}
.setting-row input[type="number"]{
    width:80px;
    padding:10px 12px;
    border:2px solid var(--border);
    border-radius:10px;
    background:var(--bg-3);
    color:var(--text);
    font-size:16px;
    font-weight:700;
    text-align:center;
    outline:none;
    transition:.2s;
}
.setting-row input[type="number"]:focus{border-color:var(--accent);}

/* Переключатель */
.switch{
    position:relative;
    width:52px;
    height:30px;
    flex-shrink:0;
}
.switch input{opacity:0;width:0;height:0;}
.slider{
    position:absolute;
    cursor:pointer;
    top:0;left:0;right:0;bottom:0;
    background:var(--bg-3);
    border-radius:30px;
    transition:.3s;
    border:1px solid var(--border);
}
.slider:before{
    position:absolute;
    content:"";
    height:22px;width:22px;
    left:3px;bottom:3px;
    background:var(--text-2);
    border-radius:50%;
    transition:.3s;
}
input:checked + .slider{background:var(--accent);}
input:checked + .slider:before{transform:translateX(22px);background:#fff;}

/* ===== ИСТОРИЯ ===== */
.history-item{
    display:flex;
    gap:12px;
    padding:14px;
    background:var(--bg-3);
    border-radius:12px;
    margin-bottom:10px;
    transition:.2s;
}
.history-item:hover{background:var(--bg-2);border:1px solid var(--border);}
.history-item .hi-icon{
    width:44px;height:44px;
    background:linear-gradient(135deg,var(--accent),var(--accent-2));
    border-radius:12px;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:22px;
    flex-shrink:0;
}
.history-item .hi-body{flex:1;min-width:0;}
.history-item .hi-date{
    font-size:14px;
    font-weight:700;
    margin-bottom:2px;
}
.history-item .hi-info{
    font-size:12px;
    color:var(--text-2);
    display:flex;
    gap:8px;
    flex-wrap:wrap;
}
.history-item .hi-note{
    font-size:12px;
    color:var(--text-2);
    margin-top:4px;
    font-style:italic;
    padding-top:4px;
    border-top:1px dashed var(--border);
}
.history-item .hi-delete{
    width:32px;height:32px;
    border:none;background:transparent;
    color:var(--text-2);
    cursor:pointer;
    font-size:16px;
    border-radius:50%;
    transition:.2s;
    flex-shrink:0;
    align-self:flex-start;
}
.history-item .hi-delete:hover{background:var(--danger);color:#fff;}

.empty-history{
    text-align:center;
    padding:40px 20px;
    color:var(--text-2);
}
.empty-history .icon{font-size:48px;margin-bottom:12px;display:block;opacity:0.5;}

/* ===== СТАТИСТИКА ===== */
.stats-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
}
.stat-box{
    padding:16px;
    background:var(--bg-3);
    border-radius:12px;
    text-align:center;
}
.stat-box .val{
    font-size:26px;
    font-weight:800;
    color:var(--accent);
    margin-bottom:4px;
}
.stat-box .lbl{
    font-size:11px;
    color:var(--text-2);
    text-transform:uppercase;
    letter-spacing:0.5px;
    font-weight:600;
}

/* ===== МОДАЛКА ===== */
.modal-overlay{
    position:fixed;
    top:0;left:0;
    width:100%;height:100%;
    background:rgba(0,0,0,.7);
    display:none;
    justify-content:center;
    align-items:flex-end;
    z-index:1000;
    backdrop-filter:blur(4px);
}
.modal-overlay.active{display:flex;}
.modal{
    background:var(--bg-2);
    border-radius:24px 24px 0 0;
    padding:24px;
    width:100%;
    max-width:600px;
    max-height:90vh;
    overflow-y:auto;
    animation:slideUp .3s ease;
}
@keyframes slideUp{
    from{transform:translateY(100%);}
    to{transform:translateY(0);}
}
.modal h2{
    font-size:20px;
    font-weight:800;
    margin-bottom:20px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}
.modal h2 button{
    width:36px;height:36px;
    border:none;background:var(--bg-3);
    color:var(--text);border-radius:50%;
    cursor:pointer;font-size:18px;
}
.modal .form-group{margin-bottom:18px;}
.modal label{
    display:block;
    font-size:13px;
    font-weight:700;
    color:var(--text-2);
    text-transform:uppercase;
    letter-spacing:0.5px;
    margin-bottom:8px;
}
.modal input[type="text"],
.modal input[type="datetime-local"],
.modal textarea,
.modal select{
    width:100%;
    padding:14px 16px;
    border:2px solid var(--border);
    border-radius:12px;
    background:var(--bg-3);
    color:var(--text);
    font-size:15px;
    font-family:inherit;
    outline:none;
    transition:.2s;
}
.modal input:focus,
.modal textarea:focus,
.modal select:focus{border-color:var(--accent);}
.modal textarea{resize:vertical;min-height:80px;}
.modal .btn-primary{
    width:100%;
    padding:16px;
    font-size:16px;
    font-weight:800;
    border:none;
    border-radius:12px;
    background:var(--accent);
    color:#fff;
    cursor:pointer;
    transition:.2s;
}
.modal .btn-primary:hover{background:var(--accent-2);}

/* Выбор места */
.location-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:8px;
}
.location-btn{
    padding:12px 8px;
    border:2px solid var(--border);
    border-radius:10px;
    background:var(--bg-3);
    color:var(--text);
    font-size:12px;
    font-weight:700;
    cursor:pointer;
    transition:.2s;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:4px;
}
.location-btn .icon{font-size:20px;}
.location-btn.selected{
    border-color:var(--accent);
    background:rgba(52,152,219,.15);
    color:var(--accent);
}
.location-btn:hover{border-color:var(--accent);}

/* Уведомление */
.toast{
    position:fixed;
    bottom:100px;
    left:50%;
    transform:translateX(-50%) translateY(100px);
    background:var(--bg-2);
    color:var(--text);
    padding:14px 24px;
    border-radius:12px;
    box-shadow:0 8px 30px rgba(0,0,0,.5);
    border:1px solid var(--border);
    font-size:14px;
    font-weight:600;
    z-index:2000;
    transition:.3s;
    display:flex;
    align-items:center;
    gap:10px;
    max-width:90vw;
}
.toast.show{transform:translateX(-50%) translateY(0);}
.toast.success{border-left:4px solid var(--success);}
.toast.warning{border-left:4px solid var(--warning);}
.toast.error{border-left:4px solid var(--danger);}

/* ===== BOTTOM NAV ===== */
.bottom-nav{
    position:fixed;
    bottom:0;left:0;right:0;
    background:var(--bg-2);
    border-top:1px solid var(--border);
    display:flex;
    justify-content:space-around;
    padding:8px 0 max(8px,env(safe-area-inset-bottom));
    z-index:100;
}
.bottom-nav button{
    flex:1;
    background:transparent;
    border:none;
    color:var(--text-2);
    font-size:11px;
    font-weight:700;
    padding:6px;
    cursor:pointer;
    transition:.2s;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:3px;
}
.bottom-nav button .icon{font-size:22px;}
.bottom-nav button.active{color:var(--accent);}
.bottom-nav button:hover{color:var(--accent);}

/* ===== TAB CONTENT ===== */
.tab-content{display:none;}
.tab-content.active{display:block;animation:fadeIn .3s ease;}
@keyframes fadeIn{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}

/* ===== INFO BOX ===== */
.info-box{
    padding:12px 16px;
    background:rgba(52,152,219,.1);
    border-left:4px solid var(--accent);
    border-radius:10px;
    font-size:13px;
    line-height:1.6;
    color:var(--text-2);
    margin-bottom:16px;
}
.info-box .title{
    color:var(--accent);
    font-weight:700;
    margin-bottom:4px;
}

/* ===== WARNING ===== */
.warning-box{
    background:rgba(243,156,18,.15);
    border-left:4px solid var(--warning);
}
.warning-box .title{color:var(--warning);}

/* ===== CONFIRM MODAL ===== */
.confirm-modal .modal{
    border-radius:16px;
    padding:24px;
    text-align:center;
    max-width:340px;
    margin:auto;
    animation:zoomIn .2s ease;
}
@keyframes zoomIn{from{transform:scale(.9);opacity:0;}to{transform:scale(1);opacity:1;}}
.confirm-modal .emoji{font-size:48px;margin-bottom:12px;display:block;}
.confirm-modal h3{font-size:18px;margin-bottom:8px;}
.confirm-modal p{font-size:14px;color:var(--text-2);margin-bottom:20px;}
.confirm-modal .btns{display:flex;gap:8px;}
.confirm-modal .btns button{
    flex:1;
    padding:12px;
    border:none;
    border-radius:10px;
    font-size:14px;
    font-weight:700;
    cursor:pointer;
}
.confirm-modal .btn-yes{background:var(--danger);color:#fff;}
.confirm-modal .btn-no{background:var(--bg-3);color:var(--text);}
</style>
</head>
<body>

<!-- HEADER -->
<div class="header">
    <h1><span class="icon">💉</span> Смена канюли</h1>
    <button class="btn-icon" id="btn-settings" title="Настройки">⚙️</button>
</div>

<!-- MAIN -->
<div class="main">

    <!-- ===== ВКЛАДКА: ГЛАВНАЯ ===== -->
    <div class="tab-content active" id="tab-home">
        <div class="card status-card" id="status-card">
            <div class="status-emoji" id="status-emoji">💉</div>
            <div class="status-title" id="status-title">Загрузка...</div>
            <div class="status-subtitle" id="status-subtitle">Последняя замена</div>
            <div class="status-time" id="status-time">--:--</div>
            <div class="status-label">до следующей замены</div>
            <div class="progress-bar">
                <div class="progress-fill" id="progress-fill" style="width:0%"></div>
            </div>
        </div>

        <button class="big-btn" id="btn-replace">
            <span class="icon">✅</span> Я поменял канюлю
        </button>

        <div class="card" id="last-replace-info">
            <div class="card-title">📅 Последняя замена</div>
            <div id="last-replace-content">
                <div class="card-subtitle">Пока нет записей</div>
            </div>
        </div>

        <div class="info-box">
            <div class="title">💡 Рекомендация</div>
            Канюлю рекомендуется менять каждые <b>48-72 часа</b> в зависимости от типа и рекомендаций врача.
        </div>
    </div>

    <!-- ===== ВКЛАДКА: ИСТОРИЯ ===== -->
    <div class="tab-content" id="tab-history">
        <div class="card">
            <div class="card-title">
                <span>📋 История замен</span>
                <span id="history-count" style="font-size:12px;color:var(--text-2);"></span>
            </div>
            <div id="history-list">
                <div class="empty-history">
                    <span class="icon">📭</span>
                    Пока нет записей
                </div>
            </div>
        </div>
    </div>

    <!-- ===== ВКЛАДКА: СТАТИСТИКА ===== -->
    <div class="tab-content" id="tab-stats">
        <div class="card">
            <div class="card-title">📊 Статистика</div>
            <div class="stats-grid">
                <div class="stat-box">
                    <div class="val" id="stat-total">0</div>
                    <div class="lbl">Всего замен</div>
                </div>
                <div class="stat-box">
                    <div class="val" id="stat-avg">0ч</div>
                    <div class="lbl">Средний интервал</div>
                </div>
                <div class="stat-box">
                    <div class="val" id="stat-month">0</div>
                    <div class="lbl">За месяц</div>
                </div>
                <div class="stat-box">
                    <div class="val" id="stat-streak">0</div>
                    <div class="lbl">Дней подряд</div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-title">📍 Популярные места</div>
            <div id="stats-locations">
                <div class="card-subtitle">Пока нет данных</div>
            </div>
        </div>
    </div>

    <!-- ===== ВКЛАДКА: ПОМОЩЬ ===== -->
    <div class="tab-content" id="tab-help">
        <div class="card">
            <div class="card-title">📖 Как пользоваться</div>
            <div style="font-size:14px;line-height:1.8;color:var(--text-2);">
                <p style="margin-bottom:12px;"><b style="color:var(--text);">1.</b> Нажми <b style="color:var(--success);">«Я поменял канюлю»</b> когда заменишь.</p>
                <p style="margin-bottom:12px;"><b style="color:var(--text);">2.</b> Укажи место установки и добавь заметку (опционально).</p>
                <p style="margin-bottom:12px;"><b style="color:var(--text);">3.</b> Приложение автоматически отсчитает время до следующей замены.</p>
                <p style="margin-bottom:12px;"><b style="color:var(--text);">4.</b> Когда время придёт — приложение покажет напоминание и уведомление.</p>
                <p><b style="color:var(--text);">5.</b> Следи за статусом на главном экране.</p>
            </div>
        </div>

        <div class="card">
            <div class="card-title">💉 Виды канюль и сроки</div>
            <div style="font-size:14px;line-height:1.7;color:var(--text-2);">
                <p style="margin-bottom:10px;"><b style="color:var(--text);">🔹 Стальные иглы</b> — 1-3 дня</p>
                <p style="margin-bottom:10px;"><b style="color:var(--text);">🔹 Тефлоновые канюли</b> — 2-4 дня</p>
                <p style="margin-bottom:10px;"><b style="color:var(--text);">🔹 Мягкие канюли</b> — 2-3 дня</p>
