// Автосохранение настроек
['setting-hours'].forEach(id => {
    document.getElementById(id).addEventListener('change', saveSettings);
});
['setting-notifications', 'setting-sound', 'setting-dark'].forEach(id => {
    document.getElementById(id).addEventListener('change', saveSettings);
});

// Экспорт
document.getElementById('btn-export').addEventListener('click', exportData);

// Очистить всё
document.getElementById('btn-clear').addEventListener('click', () => {
    askConfirm(
        '🗑️',
        'Очистить всю историю?',
        'Все ' + state.replacements.length + ' записей будут удалены навсегда',
        () => {
            state.replacements = [];
            saveState();
            updateMainScreen();
            renderHistory();
            renderStats();
            showToast('Вся история удалена', 'warning');
        }
    );
});

// Тест уведомления
document.getElementById('btn-test-notif').addEventListener('click', async () => {
    const granted = await requestNotificationPermission();
    if(granted){
        sendNotification('🧪 Тест уведомления', 'Если ты это видишь — уведомления работают! 🎉');
        playSound();
        showToast('Уведомление отправлено!', 'success');
    } else {
        showToast('Разреши уведомления в браузере', 'error');
    }
});

// Закрытие модалки по клику на оверлей
document.querySelectorAll('.modal-overlay').forEach(overlay => {
    overlay.addEventListener('click', (e) => {
        if(e.target === overlay){
            overlay.classList.remove('active');
            document.body.style.overflow = '';
        }
    });
});

/* ============================================================
   INIT
   ============================================================ */
function init(){
    loadState();
    updateMainScreen();
    renderHistory();
    renderStats();
    scheduleNotification();
    
    // Запрашиваем разрешение на уведомления
    if(state.settings.notifications && 'Notification' in window && Notification.permission === 'default'){
        setTimeout(async () => {
            const granted = await requestNotificationPermission();
            if(granted) showToast('Уведомления включены! 🔔', 'success');
        }, 2000);
    }
    
    // Обновляем экран каждые 30 секунд
    setInterval(updateMainScreen, 30000);
    
    // Проверка при возврате в приложение
    document.addEventListener('visibilitychange', () => {
        if(!document.hidden){
            updateMainScreen();
            checkReminder();
        }
    });
    
    console.log('💉 Приложение готово!');
}

init();
</script>
