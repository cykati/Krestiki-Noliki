<div class="toast" id="toast"></div>

<script>
/* ============================================================
   CONSTANTS & STATE
   ============================================================ */
const STORAGE_KEY = 'kanylya_app_v1';
const DEFAULT_INTERVAL_HOURS = 72;

let state = {
    replacements: [],
    settings: {
        intervalHours: DEFAULT_INTERVAL_HOURS,
        notifications: true,
        sound: true,
        darkTheme: true
    }
};

let currentLocation = null;
let checkInterval = null;

/* ============================================================
   STORAGE
   ============================================================ */
function loadState(){
    try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if(raw){
            const parsed = JSON.parse(raw);
            state = { ...state, ...parsed };
            state.settings = { ...state.settings, ...(parsed.settings || {}) };
        }
    } catch(e){ console.error('Ошибка загрузки:', e); }
}

function saveState(){
    try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch(e){ console.error('Ошибка сохранения:', e); }
}

/* ============================================================
   UTILS
   ============================================================ */
function formatDate(ts){
    const d = new Date(ts);
    return d.toLocaleDateString('ru-RU', { day:'2-digit', month:'2-digit', year:'numeric' });
}

function formatTime(ts){
    const d = new Date(ts);
    return d.toLocaleTimeString('ru-RU', { hour:'2-digit', minute:'2-digit' });
}

function formatDateTime(ts){
    return formatDate(ts) + ' ' + formatTime(ts);
}

function formatDuration(ms){
    if(ms < 0) ms = 0;
    const totalMin = Math.floor(ms / 60000);
    const h = Math.floor(totalMin / 60);
    const m = totalMin % 60;
    const d = Math.floor(h / 24);
    
    if(d > 0){
        const remH = h % 24;
        return d + 'д ' + remH + 'ч';
    }
    if(h > 0) return h + 'ч ' + m + 'м';
    return m + 'м';
}

function formatHoursDecimal(ms){
    const h = ms / 3600000;
    return h.toFixed(1) + 'ч';
}

function showToast(text, type = 'success', duration = 3000){
    const toast = document.getElementById('toast');
    const icons = { success:'✅', warning:'⚠️', error:'❌' };
    toast.innerHTML = '<span>' + (icons[type] || 'ℹ️') + '</span><span>' + text + '</span>';
    toast.className = 'toast ' + type + ' show';
    setTimeout(()=>{ toast.classList.remove('show'); }, duration);
}

function openModal(id){
    document.getElementById(id).classList.add('active');
    document.body.style.overflow = 'hidden';
}

function closeModal(id){
    document.getElementById(id).classList.remove('active');
    document.body.style.overflow = '';
}

/* ============================================================
   ГЛАВНАЯ ЛОГИКА
   ============================================================ */
function getLastReplacement(){
    if(state.replacements.length === 0) return null;
    return state.replacements.reduce((max, r) => r.timestamp > max.timestamp ? r : max);
}

function getNextReplacementTime(){
    const last = getLastReplacement();
    if(!last) return null;
    return last.timestamp + (state.settings.intervalHours * 3600000);
}

function updateMainScreen(){
    const card = document.getElementById('status-card');
    const emoji = document.getElementById('status-emoji');
    const title = document.getElementById('status-title');
    const subtitle = document.getElementById('status-subtitle');
    const timeEl = document.getElementById('status-time');
    const progress = document.getElementById('progress-fill');
    const lastInfo = document.getElementById('last-replace-content');

    const last = getLastReplacement();

    // Если нет записей
    if(!last){
        card.className = 'card status-card';
        emoji.textContent = '💉';
        title.textContent = 'Начни отслеживать';
        subtitle.textContent = 'Нажми кнопку ниже, когда поменяешь канюлю';
        timeEl.textContent = '--:--';
        progress.style.width = '0%';
        lastInfo.innerHTML = '<div class="card-subtitle">Пока нет записей</div>';
        return;
    }

    const next = getNextReplacementTime();
    const now = Date.now();
    const interval = state.settings.intervalHours * 3600000;
    const remaining = next - now;
    const elapsed = now - last.timestamp;
    const percent = Math.min(100, Math.max(0, (remaining / interval) * 100));

    timeEl.textContent = formatDuration(Math.max(0, remaining));
    progress.style.width = percent + '%';

    // Определяем статус
    if(remaining <= 0){
        card.className = 'card status-card danger';
        emoji.textContent = '🚨';
        title.textContent = 'ПОРА МЕНЯТЬ!';
        subtitle.textContent = 'Просрочено на ' + formatDuration(-remaining);
    } else if(remaining <= interval * 0.25){
        card.className = 'card status-card warning';
        emoji.textContent = '⚠️';
        title.textContent = 'Скоро менять';
        subtitle.textContent = 'Осталось меньше ' + Math.ceil(state.settings.intervalHours * 0.25) + ' ч';
    } else {
        card.className = 'card status-card ok';
        emoji.textContent = '✅';
        title.textContent = 'Всё в порядке';
        subtitle.textContent = 'Замена произошла в ' + formatTime(last.timestamp);
    }

    // Информация о последней замене
    let info = '<div style="font-size:15px;font-weight:700;margin-bottom:6px;">' + formatDateTime(last.timestamp) + '</div>';
    if(last.location){
        info += '<div style="font-size:13px;color:var(--text-2);margin-bottom:4px;">📍 ' + last.location + '</div>';
    }
    if(last.note){
        info += '<div style="font-size:12px;color:var(--text-2);font-style:italic;padding-top:6px;border-top:1px dashed var(--border);margin-top:6px;">💬 ' + escapeHtml(last.note) + '</div>';
    }
    info += '<div style="font-size:12px;color:var(--text-2);margin-top:6px;">Прошло: ' + formatDuration(elapsed) + '</div>';
    lastInfo.innerHTML = info;
}

function escapeHtml(text){
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

/* ============================================================
   ИСТОРИЯ
   ============================================================ */
function renderHistory(){
    const list = document.getElementById('history-list');
    const countEl = document.getElementById('history-count');

    if(state.replacements.length === 0){
        list.innerHTML = '<div class="empty-history"><span class="icon">📭</span>Пока нет записей</div>';
        countEl.textContent = '';
        return;
    }

    // Сортируем по времени (новые сверху)
    const sorted = [...state.replacements].sort((a,b) => b.timestamp - a.timestamp);
    countEl.textContent = 'Всего: ' + sorted.length;

    // Считаем интервалы
    let html = '';
    sorted.forEach((r, i) => {
        const nextOlder = sorted[i + 1];
        let intervalText = '';
        if(nextOlder){
            const diff = r.timestamp - nextOlder.timestamp;
            intervalText = ' · ⏱️ ' + formatDuration(diff);
        }

        html += `
            <div class="history-item">
                <div class="hi-icon">💉</div>
                <div class="hi-body">
                    <div class="hi-date">${formatDateTime(r.timestamp)}</div>
                    <div class="hi-info">
                        ${r.location ? '📍 ' + escapeHtml(r.location) : ''}
                        ${intervalText}
                    </div>
                    ${r.note ? '<div class="hi-note">💬 ' + escapeHtml(r.note) + '</div>' : ''}
                </div>
                <button class="hi-delete" data-id="${r.id}" title="Удалить">🗑️</button>
            </div>
        `;
    });

    list.innerHTML = html;

    // Обработчики удаления
    list.querySelectorAll('.hi-delete').forEach(btn => {
        btn.addEventListener('click', () => {
            const id = btn.dataset.id;
            askConfirm(
                '🗑️',
                'Удалить запись?',
                'Это действие нельзя отменить',
                () => deleteReplacement(id)
            );
        });
    });
}

function deleteReplacement(id){
    state.replacements = state.replacements.filter(r => r.id !== id);
    saveState();
    renderHistory();
    updateMainScreen();
    renderStats();
    showToast('Запись удалена', 'warning');
}

/* ============================================================
   СТАТИСТИКА
   ============================================================ */
function renderStats(){
    const total = state.replacements.length;
    document.getElementById('stat-total').textContent = total;

    // Средний интервал
    let avgText = '—';
    if(total >= 2){
        const sorted = [...state.replacements].sort((a,b) => a.timestamp - b.timestamp);
        let totalDiff = 0;
        for(let i = 1; i < sorted.length; i++){
            totalDiff += sorted[i].timestamp - sorted[i-1].timestamp;
        }
        const avg = totalDiff / (sorted.length - 1);
        avgText = (avg / 3600000).toFixed(1) + 'ч';
    }
    document.getElementById('stat-avg').textContent = avgText;

    // За месяц
    const now = Date.now();
    const monthAgo = now - 30 * 24 * 3600000;
    const monthCount = state.replacements.filter(r => r.timestamp >= monthAgo).length;
    document.getElementById('stat-month').textContent = monthCount;

    // Дней подряд (уникальные дни)
    const uniqueDays = new Set(state.replacements.map(r => new Date(r.timestamp).toDateString()));
    document.getElementById('stat-streak').textContent = uniqueDays.size;

    // Популярные места
    const locations = {};
    state.replacements.forEach(r => {
        if(r.location){
            locations[r.location] = (locations[r.location] || 0) + 1;
        }
    });

    const sortedLocs = Object.entries(locations).sort((a,b) => b[1] - a[1]);
    const locEl = document.getElementById('stats-locations');
    
    if(sortedLocs.length === 0){
        locEl.innerHTML = '<div class="card-subtitle">Пока нет данных</div>';
        return;
    }

    const totalLoc = sortedLocs.reduce((s, [,n]) => s + n, 0);
    let html = '';
    sortedLocs.forEach(([loc, count]) => {
        const pct = Math.round(count / totalLoc * 100);
        html += `
            <div style="margin-bottom:10px;">
                <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:4px;">
                    <span style="font-weight:700;">📍 ${escapeHtml(loc)}</span>
                    <span style="color:var(--text-2);">${count} раз (${pct}%)</span>
                </div>
                <div style="height:6px;background:var(--bg-3);border-radius:3px;overflow:hidden;">
                    <div style="height:100%;width:${pct}%;background:linear-gradient(90deg,var(--accent),var(--accent-2));border-radius:3px;transition:width .5s;"></div>
                </div>
            </div>
        `;
    });
    locEl.innerHTML = html;
}

/* ============================================================
   ЗАМЕНА
   ============================================================ */
function openReplaceModal(){
    const now = new Date();
    now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
    document.getElementById('replace-date').value = now.toISOString().slice(0, 16);
    document.getElementById('replace-note').value = '';
    currentLocation = null;
    document.querySelectorAll('.location-btn').forEach(b => b.classList.remove('selected'));
    openModal('modal-replace');
}

function confirmReplace(){
    const dateInput = document.getElementById('replace-date').value;
    const note = document.getElementById('replace-note').value.trim();
    
    if(!dateInput){
        showToast('Укажи дату и время', 'error');
        return;
    }

    const timestamp = new Date(dateInput).getTime();
    if(isNaN(timestamp)){
        showToast('Некорректная дата', 'error');
        return;
    }

    const replacement = {
        id: 'r_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6),
        timestamp: timestamp,
        location: currentLocation,
        note: note,
        createdAt: Date.now()
    };

    state.replacements.push(replacement);
    saveState();
    
    closeModal('modal-replace');
    
    updateMainScreen();
    renderHistory();
    renderStats();
    
    showToast('Замена сохранена! 💉', 'success');
    playSound();
    
    // Планируем напоминание
    scheduleNotification();
}

/* ============================================================
   НАСТРОЙКИ
   ============================================================ */
function openSettings(){
    document.getElementById('setting-hours').value = state.settings.intervalHours;
    document.getElementById('setting-notifications').checked = state.settings.notifications;
    document.getElementById('setting-sound').checked = state.settings.sound;
    document.getElementById('setting-dark').checked = state.settings.darkTheme;
    openModal('modal-settings');
}

function saveSettings(){
    const hours = parseInt(document.getElementById('setting-hours').value) || DEFAULT_INTERVAL_HOURS;
    state.settings.intervalHours = Math.min(168, Math.max(1, hours));
    state.settings.notifications = document.getElementById('setting-notifications').checked;
    state.settings.sound = document.getElementById('setting-sound').checked;
    state.settings.darkTheme = document.getElementById('setting-dark').checked;
    saveState();
    updateMainScreen();
    scheduleNotification();
    showToast('Настройки сохранены', 'success');
}

/* ============================================================
   УВЕДОМЛЕНИЯ
   ============================================================ */
async function requestNotificationPermission(){
    if(!('Notification' in window)) return false;
    if(Notification.permission === 'granted') return true;
    if(Notification.permission === 'denied') return false;
    
    const permission = await Notification.requestPermission();
    return permission === 'granted';
}

async function sendNotification(title, body){
    if(!state.settings.notifications) return;
    if(!('Notification' in window)) return;
    
    if(Notification.permission !== 'granted'){
        const granted = await requestNotificationPermission();
        if(!granted) return;
    }

    try {
        const notif = new Notification(title, {
            body: body,
            icon: 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">💉</text></svg>',
            badge: 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">💉</text></svg>',
            vibrate: [200, 100, 200],
            tag: 'kanylya-reminder',
            requireInteraction: true
        });

        notif.onclick = () => {
            window.focus();
            notif.close();
        };
    } catch(e){
        console.error('Ошибка уведомления:', e);
    }
}

function scheduleNotification(){
    if(checkInterval) clearInterval(checkInterval);
    
    // Проверяем каждую минуту
    checkInterval = setInterval(checkReminder, 60000);
    checkReminder(); // проверяем сразу
}

function checkReminder(){
    const last = getLastReplacement();
    if(!last) return;
    
    const next = getNextReplacementTime();
    const now = Date.now();
    const remaining = next - now;
    const interval = state.settings.intervalHours * 3600000;
    
    // За 2 часа до
    if(remaining > 0 && remaining <= 2 * 3600000){
        // Отправляем только раз в час
        const lastNotif = parseInt(sessionStorage.getItem('last_notif_time') || '0');
        if(now - lastNotif > 3600000){
            sendNotification(
                '⚠️ Скоро менять канюлю',
                'Осталось ' + formatDuration(remaining) + '. Подготовь новую канюлю.'
            );
            sessionStorage.setItem('last_notif_time', String(now));
        }
    }
    
    // Просрочено
    if(remaining <= 0){
        const lastNotif = parseInt(sessionStorage.getItem('last_overdue_notif') || '0');
        if(now - lastNotif > 3600000){
            sendNotification(
                '🚨 ПОРА МЕНЯТЬ КАНЮЛЮ!',
                'Просрочено на ' + formatDuration(-remaining)
            );
            sessionStorage.setItem('last_overdue_notif', String(now));
            playSound();
        }
    }
}

/* ============================================================
   ЗВУК
   ============================================================ */
let audioCtx = null;
function playSound(){
    if(!state.settings.sound) return;
    try {
        if(!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if(audioCtx.state === 'suspended') audioCtx.resume();
        
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.frequency.value = 800;
        osc.type = 'sine';
        gain.gain.value = 0.1;
        osc.start();
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.2);
        osc.stop(audioCtx.currentTime + 0.2);
    } catch(e){ console.error('Ошибка звука:', e); }
}

/* ============================================================
   ПОДТВЕРЖДЕНИЕ
   ============================================================ */
let confirmCallback = null;

function askConfirm(emoji, title, text, callback){
    document.getElementById('confirm-emoji').textContent = emoji;
    document.getElementById('confirm-title').textContent = title;
    document.getElementById('confirm-text').textContent = text;
    confirmCallback = callback;
    openModal('modal-confirm');
}

document.getElementById('confirm-yes').addEventListener('click', () => {
    if(confirmCallback) confirmCallback();
    confirmCallback = null;
    closeModal('modal-confirm');
});

/* ============================================================
   ЭКСПОРТ
   ============================================================ */
function exportData(){
    const data = {
        exportedAt: new Date().toISOString(),
        app: 'Смена канюли',
        version: '1.0',
        settings: state.settings,
        replacements: state.replacements
    };
    
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'kanylya-backup-' + formatDate(Date.now()).replace(/\./g, '-') + '.json';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    
    showToast('Файл сохранён!', 'success');
}

/* ============================================================
   TABS
   ============================================================ */
document.querySelectorAll('.bottom-nav button').forEach(btn => {
    btn.addEventListener('click', () => {
        const tab = btn.dataset.tab;
        document.querySelectorAll('.bottom-nav button').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('tab-' + tab).classList.add('active');
        
        if(tab === 'history') renderHistory();
        if(tab === 'stats') renderStats();
    });
});

/* ============================================================
   СОБЫТИЯ
   ============================================================ */
document.getElementById('btn-replace').addEventListener('click', openReplaceModal);
document.getElementById('btn-settings').addEventListener('click', openSettings);
document.getElementById('btn-confirm-replace').addEventListener('click', confirmReplace);

// Выбор места
document.querySelectorAll('.location-btn').forEach(btn => {
    btn.addEventListener('click', () => {
        document.querySelectorAll('.location-btn').forEach(b => b.classList.remove('selected'));
